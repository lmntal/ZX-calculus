//// All ZX-calculus basic rules

// spider fusion
f@@ {+L1,e^i(A),$p1,c(C1)}, {+L1,e^i(B),$p2,c(C2)}
  :- int(A), int(B), AplusB=A+B, int(C1), int(C2), C1*C2=:=1 |
  {e^i(AplusB),$p1,$p2,c(C1)}.

// hopf
hopf@@ {+L1,+L2,+I1,+O1,e^i(A),c(1)}, {+L1,+L2,+I2,+O2,e^i(B),c(-1)}
  :- int(A), int(B) | {+I1,+O1,e^i(A),c(1)}, {+I2,+O2,e^i(B),c(-1)}.

// hadamard cancellation
hh@@ h{+L1,+L2,e^i(180)}, h{+L2,+L3,e^i(180)} :- L1=L3.

// identity removal
id@@ {+L1,+L2,e^i(0),c(C)} :- int(C), C*C=:=1 | L1=L2.

// identity generation
idgen_g@@ {+L1,$p1}, {+L2,$p2}, idgen_g(N)
  :- int(N), N>0, NN=N-1 | {+L1,+LL1,$p1}, {+L2,+LL2,$p2}, {+LL1,+LL2,e^i(0),c(1)}, idgen_g(NN).
idgen_r@@ {+L1,$p1}, {+L2,$p2}, idgen_r(N)
  :- int(N), N>0, NN=N-1 | {+L1,+LL1,$p1}, {+L2,+LL2,$p2}, {+LL1,+LL2,e^i(0),c(-1)}, idgen_r(NN).

// color change
h@@ {+L,e^i(A),c(C)}, h{+L,+O,e^i(180)}
  :- int(A), int(C), CC=-C | {+O,e^i(A),c(CC)}. // for n=1
h_a@@ {+L,+LL,e^i(A),c(C),$p}, h{+L,+O,e^i(180)}
  :- int(A), int(C) | hr{{+L,+LL,e^i(A),c(C),$p}, legs{}}, h{+L,+O,e^i(180)}.
h_b@@ hr{{e^i(A),c(C),+L,$p}, legs{}, $q}
  :- int(A), int(C) | hr{{e^i(A),c(C),$p}, +L, legs{}, $q}.
h_delete_h@@ hr{{e^i(A),c(C)}, +L, legs{$l}, $q}, h{+L,e^i(180),+O}
  :- int(A), int(C) | hr{{e^i(A),c(C)}, legs{+L,$l}, $q}, L=O.
h_no_h@@ hr{{e^i(A),c(C)}, +L, legs{$l}, $q}, {+L,$o}
  :- int(A), int(C) | hr{{e^i(A),c(C)}, legs{+H,$l}, $q}, h{+H,e^i(180),+L}, {+L,$o}.
h_no_h_hr@@ hr{{e^i(A),c(C)}, +L, legs{$l}, $q}, hr{+L,$o}
  :- int(A), int(C) | hr{{e^i(A),c(C)}, legs{+H,$l}, $q}, h{+H,e^i(180),+L}, hr{+L,$o}.
h_end@@ hr{{e^i(A),c(C)}, legs{$l}}
  :- int(A), int(C), CC=-C | {e^i(A),c(CC),$l}.

// pi commutation
pi_a@@ {+L,+L1,e^i(180),c(C1)}, {+L1,+L2,e^i(A),c(C2),$p}, pi_times(P)
  :- int(A), int(C1), int(C2), C1*C2=:=-1, AA=-A, P>0, PP=P-1 |
  pi{in(L),a{e^i(AA),c(C2)}, +L2, $p}, pi_times(PP).
pi_b@@ pi{in(L),a{e^i(A),c(C),$s}, +L2, $p}
  :- int(A), int(C), CC=-C | pi{in(L),a{+L3,e^i(A),c(C),$s}, $p}, {+L2,+L3,e^i(180),c(CC)}.
pi_c@@ pi{in(L),a{$s}} :- {+L,$s}.

// copy
c_a@@ {+L1,e^i(0),c(C1)}, {+L1,+L2,e^i(A),c(C2),$p}
  :- int(A), int(C1), int(C2), C1*C2=:=-1 | c{a{+L2,$p},c(C1)}.
c_b@@ c{a{+L1,$p},c(C1),$q}
  :- int(C1) | c{{+L1,e^i(0),c(C1)},a{$p},c(C1),$q}.
c_c@@ c{a{},c(C1),$q} :- int(C1) | $q.

// bialgebra complementation
b@@ {+I,+L,e^i(A1),c(1)}, {+L,+O,e^i(A2),c(-1)}
   :- int(A1), int(A2) | {+O,+L,e^i(A1),c(1)}, {+L,+I,e^i(A2),c(-1)}. // for n=1
b_a@@ {+L1,e^i(0),c(1),$p1}, {+L1,e^i(0),c(-1),$p2}, b_times(B)
  :- int(B), B>0, BB=B-1 | b{{+L1,e^i(0),c(1),$p1}, {+L1,e^i(0),c(-1),$p2}}, b_times(BB).
b_b@@ b{{+L1,+L2,e^i(0),c(1),$p1}, {+L1,e^i(0),c(-1),$p2}}
  :- b{{+L1,e^i(0),c(1),$p1}, {+L1,e^i(0),c(-1),$p2}, left{{+L2,e^i(0),c(-1)}}}.
b_c@@ b{{+L1,+L2,e^i(0),c(1),$p1}, {+L1,e^i(0),c(-1),$p2}, left{$r}}
  :- b{{+L1,e^i(0),c(1),$p1}, {+L1,e^i(0),c(-1),$p2}, left{{+L2,e^i(0),c(-1)},$r}}.
b_d@@ b{{+L,e^i(0),c(1)}, {+L,+R,e^i(0),c(-1),$p2}, left{$r}}
  :- b{{e^i(0),c(-1),$p2}, left{$r}, right{{+R,e^i(0),c(1)}}}.
b_e@@ b{{+R,e^i(0),c(-1),$p2}, left{$r}, right{$w}}
  :- b{{e^i(0),c(-1),$p2}, left{$r}, right{{+R,e^i(0),c(1)},$w}}.
b_f@@ b{{e^i(0),c(-1)}, left{$r}, right{$w}} :- b{left{$r}, right{$w}}.
b_g@@ b{left{{+R,e^i(0),c(-1)},$r}, right{$w}}
  :- b{left{$r}, right{$w}, {+R,e^i(0),c(-1)}, right{to}, bg{}}.
b_h@@ b{left{$r}, right{{e^i(0),c(1),$pw},$w}, {+R,e^i(0),c(-1),$pr}, right{$ww,to}, bg{$bg}}
  :- b{left{$r}, right{$w}, {+W,+R,e^i(0),c(-1),$pr}, right{{+W,e^i(0),c(1),$pw},$ww,to}, bg{$bg}}.
b_i@@ b{left{{+R,e^i(0),c(-1)},$r}, right{$w,to}, right{}, bg{$bg}, {e^i(0),c(-1),$pr}}
  :- b{left{$r}, {+R,e^i(0),c(-1)}, right{$w}, right{to}, bg{{e^i(0),c(-1),$pr},$bg}}.
b_j@@ b{left{}, right{$w,to}, right{}, bg{$bg}, $q} :- $w, $bg, $q.

{
  // these rules are treated as takinig 0 steps
  system_ruleset. '$callback'(zerostep).
  {+'+', $p} :- {$p}.
  {e^i(A),$p} :- A>=360, AA=A-360 | {e^i(AA),$p}.
  {e^i(A),$p} :- A<0,    AA=A+360 | {e^i(AA),$p}.
  b_times(0) :- . pi_times(0) :- . idgen_r(0) :- . idgen_g(0) :- .
}.

