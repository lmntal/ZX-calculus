//// left
red{+L, p(180)}, green{+L, +R1, +R2, +H1, p(0)},
hadamard(H1, O1).

//// right
red{+H2, p(0)}, hadamard(H2, R11), red{+R11, +R1, +G1, p(0)},
green{+G1, +R21, p(-45)}, red{+R21, +R2, +G2, p(0)}, green{+G2, +O2, p(45)}.

//// out
o1(O1), o2(O2).

s1_red@@
red{+L1, p(P1), $p1}, red{+L1, p(P2), $p2} :- P=P1+P2 | red{p(P),$p1,$p2}.
s1_green@@
green{+L1, p(P1), $p1}, green{+L1, p(P2), $p2} :- P=P1+P2 | green{p(P),$p1,$p2}.

b1_r@@
red{p(0), +G}, green{p(0), +G, +L1, +L2}
  :- red{p(0), +L1}, red{p(0), +L2}.

b1_g@@
green{p(0), +R}, red{p(0), +R, +L1, +L2}
  :- green{p(0), +L1}, green{p(0), +L2}.

b2@@
green{p(0), +I1, +R11, +R12}, green{p(0), +I2, +R21, +R22}, red{p(0), +R11, +R21, +O1}, red{p(0), +R12, +R22, +O2}
  :- red{p(0), +I1, +I2, +G}, green{p(0), +G, +O1, +O2}.

k1_red@@
red{+G, p(180)}, green{+G, p(P), $p}
  :- PP = -P | green_k1{p(PP), $p}.

k2_r_pi@@
red{+G, p(180), $p1[L1]}, green{+G, p(P), $p2[L2]}
	:- PP=-P | green{+G, p(PP), $p1[L1]}, red{+G, p(180), $p2[L2]}.

k2_g_pi@@
green{+R, p(180), $p1[L1]}, red{+R, p(P), $p2[L2]}
	:- PP=-P | red{+R, p(PP), $p1[L1]}, green{+R, p(180), $p2[L2]}.

k_reverse_red@@
green{p(P), +R, $p}, red{p(180), +R, +M}
	:- PP = -P | green{p(PP), +M, $p}.

red_360@@
red{$p, p(P)} :- P>=360, PP=P-360 | red{$p, p(PP)}.
red_0@@
red{$p, p(P)} :- P<0, PP=P+360 | red{$p, p(PP)}.
green_360@@
green{$p, p(P)} :- P>=360, PP=P-360 | green{$p, p(PP)}.
green_360@@
green{$p, p(P)} :- P<0, PP=P+360 | green{$p, p(PP)}.
red_idem@@
red{p(0), $p[L1,L2]} :- L1=L2.

green_idem@@
green{p(0), $p[L1,L2]} :- L1=L2.

hadam_r2g@@ // just in case for 1 link connected
hadamard(L1, L2), red{p(P), +L1} :- int(P) | green{p(P), +L2}.

hadam_g2r@@ // just in case for 1 link connected
hadamard(L1, L2), green{p(P), +L1} :- int(P) | red{p(P), +L2}.

{
  system_ruleset. '$callback'(zerostep).

  // delete +'+' after s1
  red{+'+', $p} :- red{$p}.
  green{+'+', $p} :- green{$p}.

  // after k1
  k1_inc@@ green_k1{+L, $p} :- green_inc{o(L), $p}.
  inc_inc@@ green_inc{+L, $p} :- green_inc{o(L), $p}.
  inc_dec@@ green_inc{o(L), $p} :- green_dec{$p}, red{+L, p(180)}.
  back_green@@ green_dec{o(L), $p}:- green_dec{$p}, red{+L, p(180)}.
  green_dec{p(0)} :- .
  green_k1{p(0)} :- .
}.