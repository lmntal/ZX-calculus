//// connected CNOT gates
// 2 CNOTs
i{+I1}, i{+I2}, o{+O1}, o{+O2},
{+I1,+L1,+L2,c(-1),e^i(0)}, {+L1,+O1,+L3,c(-1),e^i(0)},
{+I2,+L2,+L4,c(1),e^i(0)}, {+L4,+O2,+L3,c(1),e^i(0)}.

// 3 CNOTs
i{+I1}, i{+I2}, o{+O1}, o{+O2},
{+I1,+L1,+L2,c(-1),e^i(0)}, {+L1,+L3,+L4,c(1),e^i(0)}, {+L3,+L5,+O1,c(-1),e^i(0)},
{+I2,+L2,+L6,c(1),e^i(0)}, {+L4,+L7,+L6,c(-1),e^i(0)}. {+L7,+L5,+O2,c(1),e^i(0)}.
b_times(1).

//// 2-bit Quantum Fourier Transform
// pushing |10>
{+L,c(-1),e^i(0)}, {+L,+LL,c(-1),e^i(180)}, {+LL,+R1,+R2,+H1,c(1),e^i(0)}, h{+H1,+O1,e^i(180)},
{+H2,c(-1),e^i(0)}, h{+H2,+R11,e^i(180)}, {+R11,+R1,+G1,c(-1),e^i(0)},
{+G1,+R21,c(1),e^i(-45)}, {+R21,+R2,+G2,c(-1),e^i(0)}, {+G2,+O2,c(1),e^i(45)},
o{+O1}, o{+O2}, pi_times(2).

// Pauli Pushing
{+L1,+L2,c(-1),e^i(180)}, {+L2,+L3,+D1,c(1),e^i(0)}, {+L3,+L4,+D2,c(1),e^i(0)},
{+L11,+L12,c(1),e^i(180)}, {+L12,+L13,+D1,c(-1),e^i(0)}, {+L13,+L14,c(1),e^i(90)},
{+L14,+L15,+D2,c(-1),e^i(0)}, o{+L1}, o{+L11}, o{+L4}, o{+L15}, pi_times(4).
