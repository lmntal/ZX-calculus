h_a@@ {e^i(A),c(C),$p} :- int(A), int(C) | hr{{e^i(A),c(C),$p}, legs{}, hs{}}.
h_b@@ hr{{e^i(A),c(C),+L1,$p}, legs{$l}, hs{}}
  :- int(A), int(C) | hr{{e^i(A),c(C),$p}, legs{+L1,$l}, hs{}}.
h_c@@ hr{{e^i(A),c(C)}, legs{+L,$l}, hs{$hs}}, h{+L,e^i(180),$hh}
  :- int(A), int(C) | hr{{e^i(A),c(C)}, legs{$l}, hs{+L,$hs}}, h{+L,e^i(180),$hh}.
h_nc@@ hr{{e^i(A),c(C)}, legs{+L,$l}, hs{$hs}}
  :- int(A), int(C) | {e^i(A),c(C),+L,$l,$hs}.
h_cc@@ hr{{e^i(A),c(C)}, legs{}, hs{+H,$hs}}, h{+H,+HH,e^i(180)}
  :- int(A), int(C) | hr{{e^i(A),c(C)}, legs{}, hs{$hs}, removed{+HH}}.
h_cc@@ hr{{e^i(A),c(C)}, legs{}, hs{+H,$hs}, removed{$r}}, h{+H,+HH,e^i(180)}
  :- int(A), int(C) | hr{{e^i(A),c(C)}, legs{}, hs{$hs}, removed{+HH,$r}}.
h_cce@@ hr{{e^i(A),c(C)}, legs{}, hs{}, removed{$r}}
  :- int(A), int(C) | {e^i(A),c(C),$r}.

